{
  "name": "slimefall-td",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Slimefall TD — an original tower defense game for Web, Android, iOS, Windows, macOS and Linux.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/serve.mjs www 8080",
    "dev:site": "node scripts/build-site.mjs && node scripts/serve.mjs _site 8081",
    "sim": "node scripts/simulate.mjs 8 normal",
    "test": "node scripts/simulate.mjs 4 easy && node scripts/simulate.mjs 4 hard",
    "build:site": "node scripts/build-site.mjs",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "android": "npx cap sync android && npx cap open android",
    "ios": "npx cap sync ios && npx cap open ios",
    "desktop": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/cli": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.slimefall.td",
    "productName": "Slimefall TD",
    "directories": { "output": "dist" },
    "files": ["electron/**", "www/**"],
    "win": { "target": ["nsis", "portable"], "icon": "www/icons/icon-512.png" },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.games", "icon": "www/icons/icon-512.png" },
    "linux": { "target": ["AppImage"], "category": "Game", "icon": "www/icons/icon-512.png" }
  },
  "license": "MIT"
}
